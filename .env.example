# ==============================================================================
# DANH THẮNG KÝ - CẤU HÌNH MÔI TRƯỜNG HỆ THỐNG (ENVIRONMENT CONFIGURATION)
# ==============================================================================
# HƯỚNG DẪN BẢO MẬT BITWARDEN:
# 1. Mở Bitwarden -> Tools -> Password Generator (Bộ sinh mật khẩu).
# 2. Chọn độ dài: 32 ký tự, bao gồm: Chữ hoa, chữ thường, số, ký tự đặc biệt.
# 3. Tạo một "Secure Note" trong Vault Bitwarden đặt tên: ENV_HE_THONG_EASUPSO
# 4. Lưu lại các khóa DB_PASSWORD và AUTH_SECRET vào Secure Note đó trước khi dán vào .env thực tế.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base URL cho ứng dụng (tên miền thật hoặc IP VPS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cấu hình Cơ sở dữ liệu PostgreSQL
# Lưu ý: Trong docker-compose nội bộ, host là "db" (tên service container)
DB_USER=danhthangky_user
DB_PASSWORD=THAY_BANG_CHUOI_32_KY_TU_TU_BITWARDEN
DB_NAME=danhthangky_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?schema=public

# Mã bí mật JWT xác thực phiên người dùng & Quản trị viên
# Sinh chuỗi ngẫu nhiên 32-64 ký tự từ Bitwarden
AUTH_SECRET=THAY_BANG_CHUOI_32_KY_TU_AUTH_SECRET_BITWARDEN

# Cấu hình đường dẫn lưu trữ upload ảnh và âm thanh (nội bộ container)
UPLOAD_DIR=/app/public/uploads

# Tọa độ trung tâm mặc định (Vị trí xã Ea Súp, Tỉnh Đắk Lắk)
NEXT_PUBLIC_DEFAULT_LAT=13.070029
NEXT_PUBLIC_DEFAULT_LNG=107.883355
